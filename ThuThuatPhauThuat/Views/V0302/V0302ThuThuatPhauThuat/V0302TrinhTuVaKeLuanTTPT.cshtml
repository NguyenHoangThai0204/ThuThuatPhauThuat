<script>
    // Định nghĩa biến ID mặc định cho khoa
    // Giả sử có một ID Khoa chung được biết trước, ví dụ: 1
    const DEFAULT_KHOA_ID = 1;
    let templateTomSelectInstance;
    let allTemplatesData = [];

    function normalizeData(data, tenField = 'Ten', viettatField = 'alias') {
        if (!Array.isArray(data)) {
            console.warn("normalizeData nhận dữ liệu không phải mảng:", data);
            return [];
        }

        // Trong trường hợp model M0303TemplateTTPT không có trường 'active', ta bỏ qua bước filter này.
        return data
            .map(n => {
                const ten = n[tenField]?.trim() || "";
                const viettat = n[viettatField]?.trim() || ""; // Trường này có thể không có trong model, nên ta dùng logic tạo alias

                let generatedAlias = "";

                // Nếu backend không trả về viettat, ta tự tạo từ Ten
                if (viettat !== "") {
                    generatedAlias = viettat.toUpperCase();
                } else {
                    const words = ten.split(/\s+|-|\/|\(|\)|[^\w\s]/g).filter(w => w.length > 0);

                    generatedAlias = words
                        .map(w => w.charAt(0)?.toUpperCase())
                        .join("");

                    generatedAlias = generatedAlias.replace(/[^A-Z0-9]/g, '');
                }

                return {
                    ...n,
                    // Giả sử Ten là trường hiển thị, ID là value, NoiDung là nội dung tường trình
                    alias: generatedAlias
                };
            });
    }


    function fetchDataAndNormalize(url, tenField = 'ten', viettatField = 'alias') {
        return new Promise((resolve) => {
            // Sử dụng $.ajax vì url không kết thúc bằng .json
            $.ajax({
                url: url,
                method: 'GET',
                dataType: 'json',
                success: function (templates) {
                    console.log(templates);
                    // Dùng trường Ten cho tên, không có trường viết tắt cụ thể trong M0303TemplateTTPT
                    resolve(normalizeData(templates, tenField, viettatField));
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.error(`Lỗi khi gọi API ${url}:`, textStatus, errorThrown);
                    resolve([]); // Trả về mảng rỗng nếu có lỗi
                }
            });
        });
    }

    // --- Hàm khởi tạo TomSelect và Logic chính ---

    async function initTemplateTomSelect(url) {
        console.log(`Đang tải mẫu tường trình từ: ${url}`);

        // Lấy dữ liệu mẫu tường trình
         allTemplatesData  = await fetchDataAndNormalize(url, 'ten', 'ten'); // 'Ten' là trường label, alias sẽ được tạo từ 'Ten'
        const templateSelectEl = document.querySelector('.cbTemplateTTPT');
        if (!templateSelectEl) {
            console.error("Không tìm thấy phần tử select .cbTemplateTTPT");
            return;
        }

        // Khởi tạo TomSelect
            templateTomSelectInstance = new window.TomSelect('.cbTemplateTTPT', {
            options: allTemplatesData,
            valueField: "id", // Dùng ID làm value
            labelField: "ten", // Dùng Ten làm label
            searchField: ["ten", "alias"], // Tìm kiếm theo Ten và alias
            placeholder: "-- Chọn mẫu --",
            maxItems: 1,
            // Thêm các trường dữ liệu khác vào option để truy cập sau này
            preload: true,
            //onInitialize: function() {
                // Lưu trữ dữ liệu vào instance để dễ dàng tìm kiếm sau này
                //this.allTemplatesData = allTemplatesData;
            //},
            render: {
                option: (data, escape) => `
                    <div style="display:flex; justify-content:space-between; width:100%;">
                        <span>${escape(data.ten)}</span>
                        <span style="color:gray; font-size:12px; margin-left:10px;">${escape(data.alias || "")}</span>
                    </div>`,
                item: (data, escape) => `
                    <div style="display:flex; justify-content:space-between; width:100%;">
                        <span>${escape(data.ten)}</span>
                        <span style="color:gray; font-size:12px; margin-left:10px;">${escape(data.alias || "")}</span>
                    </div>`,
                no_results: (data, escape) => `
                    <div class="no-results" style="padding:6px 10px;color:#999;">
                        Không tìm thấy "${escape(data.input)}"
                    </div>`
            }
        });

        // Xử lý sự kiện khi chọn một mẫu
        // tomSelectInstance.on('change', function(value) {
        //     if (value) {
        //         const selectedTemplate = this.allTemplates.find(t => t.id.toString() === value.toString());

        //         if (selectedTemplate && selectedTemplate.noiDung) {
        //             const editorContent = document.getElementById('editorContent');
        //             if (editorContent) {
        //                 editorContent.innerHTML = selectedTemplate.noiDung;
        //                 console.log(`Đã áp dụng mẫu: ${selectedTemplate.ten}`);
        //             }
        //         }
        //     } else {
        //         const editorContent = document.getElementById('editorContent');
        //         if (editorContent) {
        //             editorContent.innerHTML = '';
        //         }
        //     }
        // });

        // window.templateTomSelect = tomSelectInstance;

        console.log("Khởi tạo TomSelect cho Mẫu tường trình hoàn tất.");
    }

    initTemplateTomSelect(`/template_tuong_trinh/LayDanhSachTheoIDKhoa/${DEFAULT_KHOA_ID}`);


    function applyTemplate() {
        if (!templateTomSelectInstance) {
            console.error("TomSelect chưa được khởi tạo.");
            return;
        }

        const selectedTemplateId = templateTomSelectInstance.getValue();
        const editorContent = document.getElementById('editorContent');

        if (!selectedTemplateId) {
            editorContent.innerHTML = '';
            alert("Vui lòng chọn một mẫu tường trình trước khi áp dụng.");
            return;
        }

        // 1. Tìm template object đầy đủ từ ID đã chọn
        const selectedTemplate = allTemplatesData.find(t => t.id.toString() === selectedTemplateId.toString());

        if (selectedTemplate && selectedTemplate.noiDung) {
            // 2. Cập nhật nội dung vào editorContent
            editorContent.innerHTML = selectedTemplate.noiDung;
            console.log(`Đã áp dụng mẫu "${selectedTemplate.ten}" vào editor.`);
          
        } else {
            console.warn(`Không tìm thấy Nội dung cho Template ID: ${selectedTemplateId}`);
            alert("Lỗi: Không tìm thấy nội dung mẫu tường trình.");
        }
    }

    function execCmd(command, value = null) {
        document.execCommand(command, false, value);
        document.getElementById('editorContent').focus();
    }
</script>
<script src="~/dist/js/J0302/J0302TTPT/J0303TemplateTuongTrinh.js" asp-append-version="true" defer></script>
