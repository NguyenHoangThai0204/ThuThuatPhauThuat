<style>
    .form-border-container {
        position: relative;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 7px;
        margin-top: 5px;
        margin-bottom: 8px;
    }

    .border-label {
        position: absolute;
        top: -10px;
        left: 10px;
        background-color: white;
        padding: 0 5px;
        font-size: 14px;
        color: #333;
    }

    .form-border-container > .row {
        padding-top: 10px;
    }

    .table-responsive {
        min-height: 300px;
    }

    .input-group-ellipsis {
        position: relative;
    }

    .ellipsis-btn {
        position: absolute;
        right: -5px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        z-index: 10;
        padding: 2px;
        border-radius: 3px;
        transition: background-color 0.2s;
    }

        .ellipsis-btn:hover {
            background-color: #ccc;
        }

        .ellipsis-btn svg {
            width: 16px;
            height: 16px;
            color: #6c757d;
        }

    .modal-dialog {
        display: flex;
        align-items: center;
        min-height: calc(100vh - 1rem);
    }

    .modal-body .form-group {
        margin-bottom: 1rem;
    }

    .modal-body .form-label {
        min-width: 150px;
        display: inline-block;
    }

    .delete-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        border-radius: 3px;
        transition: background-color 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

        .delete-btn:hover {
            background-color: #f8f9fa;
        }

        .delete-btn svg {
            width: 16px;
            height: 16px;
            color: #dc3545;
        }

    .icd-tag {
        background-color: #e3f2fd;
        border: 1px solid #2196f3;
        border-radius: 5px;
        padding: 5px;
        padding-right:0;
        font-size: 10px;
        display: flex;
        align-items: center;
        gap: 2px;
        margin: 2px;
    }

        .icd-tag .remove-btn {
            background: none;
            border: none;
            color: #1976d2;
            cursor: pointer;
            padding: 0;
            font-size: 14px;
            line-height: 1;
            border-radius: 50%;
            /* width: 16px;
            height: 16px; */
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .icd-tag .remove-btn:hover {
                background-color: #1976d2;
                color: white;
            }

    .ts-dropdown-up {
        top: auto !important;
        bottom: 100% !important;
        margin-top: 0;
        margin-bottom: 5px;
    }

    .validation-error {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
    }

    .datepicker {
        /* transform: none !important; */
        transform: scale(1.3) translateY(-40px) !important;
        position: absolute !important;
    }
.modal-body .table-responsive {
    max-height: 400px;
    
    overflow-y: auto; 
    
}

.modal-body .table-responsive table thead th {
    position: sticky;
    top: 0; 
    z-index: 10; 
    color: white;
}

</style>
<link href="/dist/lib/litepicker/dist/css/litepicker.css" rel="stylesheet" />


<div class="mt-1 compact-form card p-2" style="min-height: 60vh;">
    <div class="row">
        <input type="hidden" id="hiddenIdVaoVien" value="@ViewBag.IdVaoVien" />
        <input type="hidden" id="hiddenTabIndex" value="@ViewBag.TabIndex" />
        <!-- Cột 1: Chẩn đoán vào khoa -->
        <div class="col-md-3">
            <div class="form-border-container">
                <label class="border-label fw-bold">Chẩn đoán vào khoa</label>
                <div class="row">
                    <div class="col-md-5 col-12">
                        <select type="text" class="form-select me-2 tom-select cbCDVaoKhoa" id="ma_icd_vao_khoa" placeholder="Mã ICD"></select>
                    </div>
                    <div class="col-md-7 col-12">
                        <div class="form-control" id="hien_thi_icd_vao_khoa" style="min-height: 35px; display: flex; flex-wrap: wrap; gap: 2px; align-items: center; padding: 1px; background-color: #F0F2F4;"></div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <textarea class="form-control " id="ten_icd_vao_khoa" rows="3" readonly placeholder=""></textarea>
                    </div>
                </div>
            </div>
            <div class="row" style="margin-bottom: 15px;">
                <div class="col-md-4">
                    <label class="form-label" style="max-width: 180px">Phòng thực hiện: </label>
                </div>
                <div class="col-md-8">
                    <input autocomplete="off" class="tom-select cbPhongThucHien form-select " type="text" name="name" />
                </div>
            </div>
            <div class="row" style="margin-bottom: 15px;">
                <div class="col-md-4">
                    <label class="col-form-label form-label text-truncate" style="max-width: 180px">Phân loại: </label>
                </div>
                <div class="col-md-8 flex-fill">
                    <input autocomplete="off" class="tom-select cbPhanLoai form-select " type="text" name="name" />
                </div>
               
            </div>
            <!-- Added ellipsis button for Thiết bị -->
            <div class="row" style="margin-bottom: 15px;">
                <div class="col-md-4">
                    <label class="col-form-label text-truncate" style="max-width: 180px">Thiết bị: </label>
                </div>
                <div class="col-md-8 flex-fill input-group-ellipsis">
                    <input autocomplete="off" class="tom-select cbThietBi form-select " type="text" name="name" />
 
                </div>
            </div>
            <div class="row" style="margin-bottom: 12px;">
                <div class="col-md-4">
                    <label for="voCamSelect" class="fw-bold">Phương thức vô cảm :</label>
                </div>
                <div class="col-8">
                    <select class="tom-select cbPTVoCam form-select " type="text" name="name" id="voCamSelect"></select>

                </div>
            </div>
            <div class="row mb-3">
                <label for="can_thiep_thu_thuat" class="col-4 col-form-label">Can thiệp thủ thuật :</label>
                <div class="col-8">
                    <textarea class="form-control" rows="3" id="can_thiep_thu_thuat"></textarea>
                </div>
            </div>

        </div>

        <!-- Cột 2: Chẩn đoán trước thủ thuật -->
        <div class="col-md-3">
            <div class="form-border-container">
                <label class="border-label fw-bold col-form-label">Chẩn đoán trước thủ thuật</label>
                <div class="row">
                    <div class="col-md-5 col-12">
                        <select type="text" class="form-select   me-2 tom-select cbTruocThuThuat" id="ma_icd_truoc_thuat" placeholder="Mã ICD"></select>
                    </div>
                    <div class="col-md-7 col-12">
                        <div class="form-control " id="hien_thi_icd_truoc_thuat" style="min-height: 35px; display: flex; flex-wrap: wrap; gap: 4px; align-items: center; padding: 1px; background-color: #F0F2F4;"></div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <textarea class="form-control  " id="ten_icd_truoc_thuat" rows="3" readonly placeholder=""></textarea>
                    </div>
                </div>
            </div>
            <!-- Added ellipsis button for Tai biến/biến chứng -->
            <div class="row" style="margin-bottom: 12px;">
                <div class="col-md-4">
                    <label class="fw-bold" title="Tai biến/biến chứng" style="max-width: 180px" onclick="openModal('bienChungModal')">Tai biến/biến chứng: </label>
                </div>
                <div class="col-md-8 flex-fill input-group-ellipsis">
                    <input autocomplete="off" class="tom-select cbBienChung form-select " type="text" name="name" />

                </div>
            </div>
            <!-- Added ellipsis button for Chế độ thủ thuật -->
            <div class="row" style="margin-bottom: 10px;">
                <div class="col-md-4">
                    <label class="fw-bold" style="max-width: 180px" onclick="openModal('cheDoThuThuatModal')">Chế độ thủ thuật: </label>
                </div>
                <div class="col-md-8 flex-fill input-group-ellipsis">
                    <input autocomplete="off" class="tom-select cbCheDoThuThuat form-select " type="text" name="name" />

                </div>
            </div>
            <!-- Added ellipsis button for Vị trí thực hiện -->
            <div class="row" style="margin-bottom: 15px;">
                <div class="col-md-4">
                    <label class="col-form-label form-label text-truncate" style="max-width: 180px" onclick="openModal('viTriThucHienModal')">Vị trí thực hiện: </label>
                </div>
                <div class="col-md-8 flex-fill input-group-ellipsis">
                    <input autocomplete="off" class="tom-select cbViTriThucHien form-select " type="text" name="name" />

                </div>
            </div>
            <div class="row" style="margin-bottom: 15px;">
                <label for="so_lan_mo_lai" class="col-4 col-form-label">Số lần mổ lại :</label>
                <div class="col-8">
                    <input autocomplete="off" type="number" class="form-control " id="so_lan_mo_lai">
                </div>
            </div>
            <div class="row" style="margin-bottom: 10px;">
                <label for="ly_do_mo_lai" class="col-4 col-form-label">Lý do mổ lại :</label>
                <div class="col-8">
                    <textarea autocomplete="off" rows="3" class="form-control " id="ly_do_mo_lai"></textarea>
                </div>
            </div>
           
        </div>

        <!-- Cột 3: Chẩn đoán sau thủ thuật -->
        <div class="col-md-3">
            <div class="form-border-container">
                <label class="border-label fw-bold">Chẩn đoán sau thủ thuật</label>
                <div class="row">
                    <div class="col-md-5 col-12">
                        <select type="text" class="form-select  me-2 tom-select cbSauThuThuat" id="ma_icd_sau_thuat" placeholder="Mã ICD"></select>
                    </div>
                    <div class="col-md-7 col-12">
                        <div class="form-control " id="hien_thi_icd_sau_thuat" style="min-height: 35px; display: flex; flex-wrap: wrap; gap: 4px; align-items: center; padding: 1px; background-color: #F0F2F4;"></div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <textarea class="form-control " id="ten_icd_sau_thuat" rows="3" readonly placeholder=""></textarea>
                    </div>
                </div>
            </div>
            <div class="row" style="margin-bottom: 15px;">
                <div class="col-md-4">
                    <label class="col-form-label form-label text-truncate" style="max-width: 180px" onclick="openModal('tuVongModal')">Tử vong: </label>
                </div>
                <div class="col-md-8 flex-fill">
                    <input autocomplete="off" class="tom-select  cbTuVong form-select" type="text" name="name" />
                </div>
            </div>
            <div class="row" style="margin-bottom: 13px;">
                <label for="dan_luu" class="col-4 col-form-label">Dẫn lưu :</label>
                <div class="col-8">
                    <input autocomplete="off" type="text" class="form-control " id="dan_luu">
                </div>
            </div>
            <div class="row" style="margin-bottom: 12px;">
                <label for="ngay_rut_ong_dan_luu" class="col-4 fw-bold">Ngày rút ống dẫn lưu</label>

                <div class="col-8 datepicker-wrapper">
                  @*  <input autocomplete="off" class="form-control " lang="vi" id="ngay_rut_ong_dan_luu" placeholder="dd-mm-yyyy">*@
                    <div class="input-icon w-100">
                        <input type="text"
                            id="ngay_rut_ong_dan_luu"
                               class="form-control form-control-md txtDateTimeNgayRutOng text-dark"
                               autocomplete="off" />
                        <span class="input-icon-addon">
                            <i class="ti ti-calendar-event"></i>
                        </span>
                    </div> 

                </div> 
            </div>
            <div class="row" style="margin-bottom: 15px; ">
                <label for="ngay_cat_chi" class="col-4 col-form-label">Ngày cắt chỉ :</label>

                <div class="col-8 datepicker-wrapper">
                 @*   <input autocomplete="off" class="form-control " lang="vi" id="ngay_cat_chi" placeholder="dd-mm-yyyy">*@
                     <div class="input-icon w-100">
                        <input type="text"
                          id="ngay_cat_chi"
                               class="form-control form-control-md txtDateTimeNgayCatChi text-dark"
                               autocomplete="off" />
                        <span class="input-icon-addon">
                            <i class="ti ti-calendar-event"></i>
                        </span>
                    </div> 
                </div>
            </div>
            <div class="row" style="margin-bottom: 10px;">
                <label for="khac" class="col-4 col-form-label">Khác :</label>
                <div class="col-8">
                        <textarea class="form-control" rows="3" id="khac"></textarea>
                </div>
            </div>
        </div>

        <!-- Cột 4: FNA -->
        <div class="col-md-3">
            <div class="form-border-container">
                <label class="border-label fw-bold">FNA</label>
                <div class="d-flex align-content-center" style="margin-top: 10px;">
                    <label for="ma_fna" class="col-form-label" style="min-width:70px;">Mã FNA :</label>
                    <input autocomplete="off" type="text" class="form-control " id="ma_fna">

                </div>
                <div class="d-flex align-content-center" style="margin-top: 10px;">
                    <label for="tien_can" class="col-form-label" style="min-width:70px;">Tiền căn :</label>
                    <textarea autocomplete="off" class="form-control " rows="3" id="tien_can"></textarea>

                </div>
            </div>
            <div style="margin-bottom: 5px;">
                <label for="ket_qua_xet_nghiem" class="fw-bold">Kết quả xét nghiệm FNA, GBP lần trước : </label>
                <textarea autocomplete="off" class="form-control " id="ket_qua_xet_nghiem"></textarea>
            </div style="margin-bottom: 5px;">
            <div style="margin-bottom: 5px;">
                <label for="chi_dinh_vi_tri_ton_thuong_fna" class="fw-bold">Chỉ định vị trí tổn thương FNA :</label>
                <textarea autocomplete="off" rows="3" class="form-control " id="chi_dinh_vi_tri_ton_thuong_fna"></textarea>
            </div>
            <div style="margin-bottom: 5px;">
                <label for="yeu_cau_xet_nghiem" class="fw-bold">Yêu cầu xét nghiệm :</label>
                <textarea autocomplete="off" rows="3" class="form-control " id="yeu_cau_xet_nghiem"></textarea>
            </div>
           
        </div>
    </div>
</div>



<!-- Modal for Tai biến/biến chứng -->
<div class="modal fade" id="bienChungModal" tabindex="-1" aria-labelledby="bienChungModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bienChungModalLabel">Quản lý Danh mục Tai biến/Biến chứng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-7 border-end pe-4">
                        <h4 class="mb-3">Danh sách Tai biến/Biến chứng hiện có</h4>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped align-middle table-sm">
                                <thead>
                                    <tr class="table-primary">
                                        <th scope="col" style="width: 5%;">STT</th>
                                        <th scope="col" style="width: 20%;">Mã Danh mục</th>
                                        <th scope="col" style="width: 45%;">Tên Danh mục</th>
                                        <th scope="col" style="width: 30%;" class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="bienChungTableBody">
                                    <tr>
                                        <th scope="row">1</th>
                                        <td>BC001</td>
                                        <td>Nhiễm trùng vết mổ</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-warning me-2" onclick="editBienChung('BC001')">Sửa</button>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="deleteBienChung('BC001')">Xóa</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-5 ps-4">
                        <h4 class="mb-3">Thêm/Chỉnh sửa Tai biến/Biến chứng</h4>
                        <form id="bienChungForm">
                            <input type="hidden" id="bienChungId" value="">
                            
                            <div class="form-group mb-3">
                                <label for="bienChungMa" class="form-label">Mã tai biến/biến chứng:</label>
                                <input autocomplete="off" type="text" class="form-control" id="bienChungMa" required>
                            </div>
                            <div class="form-group mb-3">
                                <label for="bienChungTen" class="form-label">Tên tai biến/biến chứng:</label>
                                <input autocomplete="off" type="text" class="form-control" id="bienChungTen" required>
                            </div>
                            
                            <div class="d-grid gap-2 mt-4">
                                <button type="button" class="btn btn-primary btn-lg" onclick="saveBienChung()">Lưu Danh mục</button>
                                <button type="button" 
                                        class="btn btn-secondary btn-lg" 
                                        id="bienChungCancelBtn" 
                                        style="display: none;" 
                                        onclick="resetBienChungForm()">
                                    Hủy Sửa
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

