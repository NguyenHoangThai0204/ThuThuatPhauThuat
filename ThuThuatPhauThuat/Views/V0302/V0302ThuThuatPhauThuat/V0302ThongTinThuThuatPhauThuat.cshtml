<script src="~/dist/js/J0302/J0302TTPT/J0302ThongTinThuThuat.js" asp-append-version="true" defer></script>
<script src="~/dist/lib/litepicker/dist/litepicker.js" asp-append-version="true" defer></script>

<script>
    // Hàm khởi tạo datepicker
       function initDatePicker(inputId) {
      $('#' + inputId).datepicker({
        format: "dd/mm/yyyy",
        language: "vi",
        autoclose: true,
          todayHighlight: true, container: 'body',
    orientation: "auto"
      });
     $('#' + inputId).inputmask('99-99-9999', { placeholder: 'dd-mm-yyyy' });

    }

    // Gọi cho từng input
  

    // Khởi tạo khi tab được mở
    $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
        var target = $(e.target).attr("href"); // tab được mở

        if (target === "#tabs-thongtin-7") {
              initDatePicker('ngay_cat_chi');
              initDatePicker('ngay_rut_ong_dan_luu');
        }
    });

    // Nếu tab #tabs-thongtin-7 là mặc định mở thì khởi tạo luôn
    if ($('#tabs-thongtin-7').hasClass('active show')) {
        initDatePicker('ngay_cat_chi');
        initDatePicker('ngay_rut_ong_dan_luu');
    }
</script>


