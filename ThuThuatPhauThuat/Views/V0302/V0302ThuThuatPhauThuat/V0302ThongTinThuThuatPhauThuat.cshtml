<style>
    .form-border-container {
        position: relative;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 7px;
        margin-top: 5px;
        margin-bottom: 8px;
    }

    .border-label {
        position: absolute;
        top: -10px;
        left: 10px;
        background-color: white;
        padding: 0 5px;
        font-size: 14px;
        color: #333;
    }

    .form-border-container > .row {
        padding-top: 10px;
    }

    .table-responsive {
        min-height: 300px;
    }

    .input-group-ellipsis {
        position: relative;
    }

    .ellipsis-btn {
        position: absolute;
        right: -5px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        z-index: 10;
        padding: 2px;
        border-radius: 3px;
        transition: background-color 0.2s;
    }

        .ellipsis-btn:hover {
            background-color: #ccc;
        }

        .ellipsis-btn svg {
            width: 16px;
            height: 16px;
            color: #6c757d;
        }

    .modal-dialog {
        display: flex;
        align-items: center;
        min-height: calc(100vh - 1rem);
    }

    .modal-body .form-group {
        margin-bottom: 1rem;
    }

    .modal-body .form-label {
        min-width: 150px;
        display: inline-block;
    }

    .delete-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        border-radius: 3px;
        transition: background-color 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

        .delete-btn:hover {
            background-color: #f8f9fa;
        }

        .delete-btn svg {
            width: 16px;
            height: 16px;
            color: #dc3545;
        }

    .icd-tag {
        background-color: #e3f2fd;
        border: 1px solid #2196f3;
        border-radius: 5px;
        padding: 5px;
        padding-right:0;
        font-size: 10px;
        display: flex;
        align-items: center;
        gap: 2px;
        margin: 2px;
    }

        .icd-tag .remove-btn {
            background: none;
            border: none;
            color: #1976d2;
            cursor: pointer;
            padding: 0;
            font-size: 14px;
            line-height: 1;
            border-radius: 50%;
            /* width: 16px;
            height: 16px; */
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .icd-tag .remove-btn:hover {
                background-color: #1976d2;
                color: white;
            }

    .ts-dropdown-up {
        top: auto !important;
        bottom: 100% !important;
        margin-top: 0;
        margin-bottom: 5px;
    }

    .validation-error {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
    }

    .datepicker {
        /* transform: none !important; */
        transform: scale(1.3) translateY(-40px) !important;
        position: absolute !important;
    }

</style>
