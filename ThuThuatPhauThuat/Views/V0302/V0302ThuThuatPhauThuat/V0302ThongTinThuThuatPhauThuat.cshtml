<style>
    .col-form-label {
        padding-top: 2px;
        padding-bottom: 2px;
        font-size: 13px;
    }

    .form-border-container {
        position: relative;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 5px;
        margin-top: 5px;
        margin-bottom: 5px;
    }

    .border-label {
        position: absolute;
        top: -10px;
        left: 10px;
        background-color: white;
        padding: 0 5px;
        font-size: 13px;
        color: #333;
    }

    .form-border-container > .row {
        padding-top: 10px;
    }

    .table-responsive {
        min-height: 300px;
    }

    /* Updated modal styles for centering and label width */
    .input-group-ellipsis {
        position: relative;
    }

    .ellipsis-btn {
        position: absolute;
        right: -5px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        z-index: 10;
        padding: 2px;
        border-radius: 3px;
        transition: background-color 0.2s;
    }

        .ellipsis-btn:hover {
            background-color: #ccc;
        }

        .ellipsis-btn svg {
            width: 16px;
            height: 16px;
            color: #6c757d;
        }

    .modal-dialog {
        display: flex;
        align-items: center;
        min-height: calc(100vh - 1rem);
    }

    .modal-body .form-group {
        margin-bottom: 1rem;
    }

    .modal-body .form-label {
        min-width: 150px;
        display: inline-block;
    }

    /* Added styles for anesthesia table delete buttons */
    .delete-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        border-radius: 3px;
        transition: background-color 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }

        .delete-btn:hover {
            background-color: #f8f9fa;
        }

        .delete-btn svg {
            width: 16px;
            height: 16px;
            color: #dc3545;
        }

    /* ICD tag styles */
    .icd-tag {
        background-color: #e3f2fd;
        border: 1px solid #2196f3;
        border-radius: 16px;
        padding: 4px 12px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 2px;
    }

        .icd-tag .remove-btn {
            background: none;
            border: none;
            color: #1976d2;
            cursor: pointer;
            padding: 0;
            font-size: 14px;
            line-height: 1;
            border-radius: 50%;
            width: 16px;
            height: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .icd-tag .remove-btn:hover {
                background-color: #1976d2;
                color: white;
            }
</style>

<div class="container mt-1 compact-form card p-2">
    <div class="row">
        <input type="hidden" id="hiddenIdVaoVien" value="@ViewBag.IdVaoVien" />
        <input type="hidden" id="hiddenTabIndex" value="@ViewBag.TabIndex" />
        <!-- Cột 1: Chẩn đoán vào khoa -->
        <div class="col-md-3">
            <div class="form-border-container">
                <label class="border-label fw-bold">Chẩn đoán vào khoa</label>
                <div class="row" style="margin-bottom: 6px;">
                    <div class="col-4">
                        <input type="text" class="form-control form-control-md  me-2 tom-select cbCDVaoKhoa" id="ma_icd_vao_khoa" placeholder="Mã ICD">
                    </div>
                    <div class="col-8">
                        <div class="form-control form-control-md" id="hien_thi_icd_vao_khoa" style="min-height: 38px; display: flex; flex-wrap: wrap; gap: 4px; align-items: center;"></div>
                    </div>
                </div>
                <div class="row" style="margin-bottom: 6px;">
                    <div class="col-12">
                        <textarea class="form-control " id="ten_icd_vao_khoa" rows="3" readonly placeholder="" style="height: 25px;"></textarea>
                    </div>
                </div>
            </div>
            <div class="row" style="margin-bottom: 6px;">
                <div class="col-md-4">
                    <label class="col-form-label form-label text-truncate" style="max-width: 180px">Phòng thực hiện: </label>
                </div>
                <div class="col-md-8">
                    <input class="tom-select cbPhongThucHien form-select form-select-md" type="text" name="name" />
                </div>
            </div>
            <div class="row" style="margin-bottom: 6px;">
                <div class="col-md-4">
                    <label class="col-form-label form-label text-truncate" style="max-width: 180px">Phân loại: </label>
                </div>
                <div class="col-md-8 flex-fill">
                    <input class="tom-select cbPhanLoai form-select form-select-md" type="text" name="name" />
                </div>
            </div>
            <!-- Added ellipsis button for Thiết bị -->
            <div class="row" style="margin-bottom: 6px;">
                <div class="col-md-4">
                    <label class="col-form-label form-label text-truncate" style="max-width: 180px">Thiết bị: </label>
                </div>
                <div class="col-md-8 flex-fill input-group-ellipsis">
                    <input class="tom-select cbThietBi form-select form-select-md" type="text" name="name" />
                    <button type="button" class="ellipsis-btn" onclick="openModal('thietBiModal')">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="1" />
                            <circle cx="12" cy="5" r="1" />
                            <circle cx="12" cy="19" r="1" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="row mb-3">
                <label for="can_thiep_thu_thuat" class="col-4 col-form-label">Can thiệp thủ thuật</label>
                <div class="col-8">
                    <textarea class="form-control" rows="3" id="can_thiep_thu_thuat" rows="3"></textarea>
                </div>
            </div>
        </div>

        <!-- Cột 2: Chẩn đoán trước thủ thuật -->
        <div class="col-md-3">
            <div class="form-border-container">
                <label class="border-label fw-bold col-form-label">Chẩn đoán trước thủ thuật</label>
                <div class="row" style="margin-bottom: 6px;">
                    <div class="col-4">
                        <input type="text" class="form-control  form-control-md me-2 tom-select cbTruocThuThuat" id="ma_icd_truoc_thuat" placeholder="Mã ICD">
                    </div>
                    <div class="col-8">
                        <div class="form-control form-control-md" id="hien_thi_icd_truoc_thuat" style="min-height: 38px; display: flex; flex-wrap: wrap; gap: 4px; align-items: center;"></div>
                    </div>
                </div>
                <div class="row" style="margin-bottom: 6px;">
                    <div class="col-12">
                        <textarea class="form-control  " id="ten_icd_truoc_thuat" rows="3" style="height: 25px;" readonly placeholder=""></textarea>
                    </div>
                </div>
            </div>
            <!-- Added ellipsis button for Tai biến/biến chứng -->
            <div class="row" style="margin-bottom: 6px;">
                <div class="col-md-4">
                    <label class="col-form-label form-label text-truncate" title="Tai biến/biến chứng" style="max-width: 180px">Tai biến/biến chứng: </label>
                </div>
                <div class="col-md-8 flex-fill input-group-ellipsis">
                    <input class="tom-select cbBienChung form-select form-select-md" type="text" name="name" />
                    <button type="button" class="ellipsis-btn" onclick="openModal('bienChungModal')">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="1" />
                            <circle cx="12" cy="5" r="1" />
                            <circle cx="12" cy="19" r="1" />
                        </svg>
                    </button>
                </div>
            </div>
            <!-- Added ellipsis button for Chế độ thủ thuật -->
            <div class="row" style="margin-bottom: 6px;">
                <div class="col-md-4">
                    <label class="col-form-label form-label text-truncate" style="max-width: 180px">Chế độ thủ thuật: </label>
                </div>
                <div class="col-md-8 flex-fill input-group-ellipsis">
                    <input class="tom-select cbCheDoThuThuat form-select form-select-md" type="text" name="name" />
                    <button type="button" class="ellipsis-btn" onclick="openModal('cheDoThuThuatModal')">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="1" />
                            <circle cx="12" cy="5" r="1" />
                            <circle cx="12" cy="19" r="1" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="row" style="margin-bottom: 6px;">
                <label for="so_lan_mo_lai" class="col-4 col-form-label">Số lần mổ lại :</label>
                <div class="col-8">
                    <input type="number" class="form-control form-control-md" id="so_lan_mo_lai">
                </div>
            </div>
            <div class="row" style="margin-bottom: 6px;">
                <label for="ly_do_mo_lai" class="col-4 col-form-label">Lý do mổ lại :</label>
                <div class="col-8">
                    <input type="text" class="form-control form-control-md" id="ly_do_mo_lai">
                </div>
            </div>
            <!-- Added ellipsis button for Vị trí thực hiện -->
            <div class="row" style="margin-bottom: 6px;">
                <div class="col-md-4">
                    <label class="col-form-label form-label text-truncate" style="max-width: 180px">Vị trí thực hiện: </label>
                </div>
                <div class="col-md-8 flex-fill input-group-ellipsis">
                    <input class="tom-select cbViTriThucHien form-select form-select-md" type="text" name="name" />
                    <button type="button" class="ellipsis-btn" onclick="openModal('viTriThucHienModal')">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="1" />
                            <circle cx="12" cy="5" r="1" />
                            <circle cx="12" cy="19" r="1" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Cột 3: Chẩn đoán sau thủ thuật -->
        <div class="col-md-3">
            <div class="form-border-container">
                <label class="border-label fw-bold">Chẩn đoán sau thủ thuật</label>
                <div class="row" style="margin-bottom: 6px;">
                    <div class="col-4">
                        <input type="text" class="form-control form-control-md me-2 tom-select cbSauThuThuat" id="ma_icd_sau_thuat" placeholder="Mã ICD">
                    </div>
                    <div class="col-8">
                        <div class="form-control form-control-md" id="hien_thi_icd_sau_thuat" style="min-height: 38px; display: flex; flex-wrap: wrap; gap: 4px; align-items: center;"></div>
                    </div>
                </div>
                <div class="row" style="margin-bottom: 6px;">
                    <div class="col-12">
                        <textarea class="form-control " id="ten_icd_sau_thuat" rows="3" style="height: 25px;" readonly placeholder=""></textarea>
                    </div>
                </div>
            </div>
            <div class="row" style="margin-bottom: 6px;">
                <div class="col-md-4">
                    <label class="col-form-label form-label text-truncate" style="max-width: 180px">Tử vong: </label>
                </div>
                <div class="col-md-8 flex-fill">
                    <input class="tom-select form-select-md cbTuVong form-select" type="text" name="name" />
                </div>
            </div>
            <div class="row" style="margin-bottom: 6px;">
                <label for="dan_luu" class="col-4 col-form-label">Dẫn lưu :</label>
                <div class="col-8">
                    <input type="text" class="form-control form-control-md" id="dan_luu">
                </div>
            </div>
            <div class="row" style="margin-bottom: 6px;">
                <label for="ngay_rut_ong_dan_luu" class="col-4 col-form-label text-truncate">Ngày rút ống dẫn lưu</label>
                <div class="col-8">
                    <input type="date" class="form-control form-control-md" id="ngay_rut_ong_dan_luu">
                </div>
            </div>
            <div class="row" style="margin-bottom: 6px;">
                <label for="ngay_cat_chi" class="col-4 col-form-label">Ngày cắt chỉ :</label>
                <div class="col-8">
                    <input type="date" class="form-control form-control-md" id="ngay_cat_chi">
                </div>
            </div>
            <div class="row" style="margin-bottom: 6px;">
                <label for="khac" class="col-4 col-form-label">Khác :</label>
                <div class="col-8">
                    <input type="text" class="form-control form-control-md" id="khac">
                </div>
            </div>
        </div>

        <!-- Cột 4: FNA -->
        <div class="col-md-3">
            <div class="form-border-container">
                <label class="border-label fw-bold">FNA</label>
                <div style="margin-bottom: 6px;" class="d-flex align-content-center">
                    <label for="ma_fna" class="col-form-label" style="min-width:70px;">Mã FNA :</label>
                    <input type="text" class="form-control form-control-md" id="ma_fna">

                </div>
                <div class="d-flex align-content-center" style="margin-bottom: 2px;">
                    <label for="tien_can" class="col-form-label" style="min-width:70px;">Tiền căn :</label>
                    <input type="text" class="form-control form-control-md" id="tien_can">

                </div>
            </div>
            <div>
                <label for="ket_qua_xet_nghiem" class="col-form-label fw-bold">Kết quả xét nghiệm FNA, GBP lần trước : </label>
                <input type="text" class="form-control form-control-md" id="ket_qua_xet_nghiem">
            </div>
            <div>
                <label for="chi_dinh_vi_tri_ton_thuong_fna" class="col-form-label fw-bold">Chỉ định vị trí tổn thương FNA :</label>
                <input type="text" class="form-control form-control-md" id="chi_dinh_vi_tri_ton_thuong_fna">
            </div>
            <div>
                <label for="yeu_cau_xet_nghiem" class="col-form-label fw-bold">Yêu cầu xét nghiệm :</label>
                <input type="text" class="form-control form-control-md" id="yeu_cau_xet_nghiem">
            </div>
        </div>
    </div>

    <!-- Hàng chứa hai bảng -->
    <div class="row">
        <!-- Bảng 1: Phương pháp vô cảm -->
        <div class="col-md-4">
            <div class="row mb-3">
                <div class="col-md-10 flex-fill">
                    <input class="tom-select cbPTVoCam form-control" type="text" name="name" id="voCamSelect" />
                </div>
                <div class="col-md-2 d-grid">
                    <button type="button" class="btn btn-primary" onclick="addAnesthesiaMethod()" style="padding-left: 15px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-plus">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path d="M12 5l0 14"></path>
                            <path d="M5 12l14 0"></path>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-vcenter text-nowrap table-text">
                    <thead class="table-light">
                        <tr>
                            <th>STT</th>
                            <th style="min-width: 300px;">Phương pháp vô cảm</th>
                            <th>#</th>
                        </tr>
                    </thead>
                    <tbody id="anesthesiaTableBody">
                        <!-- Dữ liệu sẽ được thêm vào đây -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-12 text-center">
            <button type="button" class="btn btn-success btn-lg" id="btn_saveThongTin">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-device-floppy">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                    <path d="M6 4h10l4 4v10a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2"></path>
                    <path d="M12 14m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"></path>
                    <path d="M14 4l0 4h-6l0 -4"></path>
                </svg>
                Lưu Thông Tin Thủ Thuật
            </button>
        </div>
    </div>

</div>
<script src="~/dist/js/J0302/J0302TTPT/J0302ThongTinThuThuat.js" asp-append-version="true" defer></script>



