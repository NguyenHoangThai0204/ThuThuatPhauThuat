<link href="~/dist/css/CSS0305/CSS0305TTPT/CSS0305TrinhTuVaKetLuan.css" rel="stylesheet" />

<script>
    var DEFAULT_KHOA_ID = 1;
    window.templateTomSelectInstance = window.templateTomSelectInstance || null;
    window.allTemplatesData = window.allTemplatesData || [];

    function normalizeData(data, tenField = 'Ten', viettatField = 'alias') {
        if (!Array.isArray(data)) return [];
        return data.map(n => {
            const ten = n[tenField]?.trim() || "";
            const viettat = n[viettatField]?.trim() || "";
            let generatedAlias = viettat
                ? viettat.toUpperCase()
                : (ten.split(/\s+|-|\/|\(|\)|[^\w\s]/g).filter(w => w.length > 0)
                    .map(w => w.charAt(0)?.toUpperCase())
                    .join("").replace(/[^A-Z0-9]/g, ''));
            return { ...n, alias: generatedAlias };
        });
    }

    function fetchDataAndNormalize(url, tenField = 'ten', viettatField = 'alias') {
        return new Promise((resolve) => {
            $.ajax({
                url: url,
                method: 'GET',
                dataType: 'json',
                success: templates => resolve(normalizeData(templates, tenField, viettatField)),
                error: () => resolve([])
            });
        });
    }

    async function initTemplateTomSelect(url) {
        allTemplatesData = await fetchDataAndNormalize(url, 'ten', 'ten');
        const templateSelectEl = document.querySelector('.cbTemplateTTPT');
        if (!templateSelectEl && !templateSelectEl.tomselect) return;
        templateTomSelectInstance = new window.TomSelect('.cbTemplateTTPT', {
            options: allTemplatesData,
            valueField: "id",
            labelField: "ten",
            searchField: ["ten", "alias"],
            placeholder: "-- Chọn mẫu --",
            maxItems: 1,
            preload: true,
            render: {
                option: (data, escape) => `
                    <div style="display:flex; justify-content:space-between; width:100%;">
                        <span>${escape(data.ten)}</span>
                        <span style="color:gray; font-size:12px; margin-left:10px;">${escape(data.alias || "")}</span>
                    </div>`,
                item: (data, escape) => `
                    <div style="display:flex; justify-content:space-between; width:100%;">
                        <span>${escape(data.ten)}</span>
                        <span style="color:gray; font-size:12px; margin-left:10px;">${escape(data.alias || "")}</span>
                    </div>`,
                no_results: (data, escape) =>
                    `<div class="no-results" style="padding:6px 10px;color:#999;">Không tìm thấy "${escape(data.input)}"</div>`
            }
        });
    }
    initTemplateTomSelect(`/template_tuong_trinh/LayDanhSachTheoIDKhoa/${DEFAULT_KHOA_ID}`);

    function applyTemplate() {
        if (!templateTomSelectInstance) return;
        const selectedTemplateId = templateTomSelectInstance.getValue();
        const editorContent = document.getElementById('editorContent');
        if (!selectedTemplateId) {
            editorContent.innerHTML = '';
            alert("Vui lòng chọn một mẫu tường trình trước khi áp dụng.");
            return;
        }
        const selectedTemplate = allTemplatesData.find(t => t.id.toString() === selectedTemplateId.toString());
        if (selectedTemplate && selectedTemplate.noiDung) {
            editorContent.innerHTML = selectedTemplate.noiDung;
        } else {
            alert("Lỗi: Không tìm thấy nội dung mẫu tường trình.");
        }
    }

    // ==== IMAGE PANEL LOGIC: Chỉ cho phép quản lý ảnh ở panel trái ====
    // Không còn hàm insertImageAtCursor vào editor, toàn bộ thao tác ảnh chỉ ở panel trái
    (function () {
        const imagePanel = document.querySelector('.image-panel-body');
        let uploadedImages = [];

        // Upload ảnh lên FTP
        async function uploadImageToFTP(file, idPhieuTTPT) {
            const formData = new FormData();
            formData.append('file', file);
            formData.append('idPhieuTTPT', idPhieuTTPT);

            try {
                const response = await fetch('/thu_thuat_phau_thuat/trinh-tu/upload-image', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    return result.data; // { id, url, httpUrl }
                } else {
                    // console.error('Upload failed:', result.message);
                    alert('Vui lòng chọn bệnh nhân từ danh sách');
                    return null;
                }
            } catch (error) {
                console.error('Upload error:', error);
                return null;
            }
        }

        // Panel trái: Danh sách ảnh
        function addImageToPanel(imageData) {
            // Không thêm nếu đã có
            if (imagePanel.querySelector(`[data-image-id="${imageData.id}"]`)) return;
            const imageItem = document.createElement('div');
            imageItem.className = 'image-item';
            imageItem.dataset.imageId = imageData.id;
            const time = imageData.timestamp.toLocaleString('vi-VN', {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit'
            });
            imageItem.innerHTML = `
                <div class="fw-bold">${imageData.name}</div>
                <small>${time}</small>
                <img src="${imageData.src}" class="image-item-preview" alt="${imageData.name}">
                <button class="delete-image-btn" onclick="deleteImage(${imageData.id})">
                    <i class="ti ti-trash"></i>
                </button>
            `;
            imagePanel.appendChild(imageItem);
        }

        // Xóa ảnh
        window.deleteImage = async function (imageId) {
            if (!confirm('Bạn có chắc muốn xóa ảnh này?')) return;
            const image = uploadedImages.find(img => img.id === imageId);
            if (image) {
                try {
                    const response = await fetch(`/thu_thuat_phau_thuat/trinh-tu/delete-image/${imageId}`, {
                        method: 'DELETE'
                    });
                    const result = await response.json();
                    if (!result.success) {
                        alert('Lỗi xóa ảnh từ server: ' + result.message);
                        return;
                    }
                    toastr.success("Xóa ảnh thành công");
                } catch (error) {
                    console.error('Delete error:', error);
                    alert('Lỗi xóa ảnh từ server');
                    return;
                }
            }
            // Xóa local
            uploadedImages = uploadedImages.filter(img => img.id !== imageId);
            const panelItem = imagePanel.querySelector(`[data-image-id="${imageId}"]`);
            if (panelItem) panelItem.remove();
        };

        // Nút upload ảnh trong panel trái
        const addImageBtn = document.getElementById('btnAddImagePanel');
        if (addImageBtn) {
            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.accept = 'image/*';
            fileInput.multiple = true;
            fileInput.style.display = 'none';
            document.body.appendChild(fileInput);
            addImageBtn.addEventListener('click', () => fileInput.click());
            fileInput.addEventListener('change', async function () {
                for (const file of this.files) {
                    if (file.type.startsWith('image/')) {
                        // Upload lên server và add vào panel
                        const uploadResult = await uploadImageToFTP(file, window.IDPhieuTTPT);
                        if (uploadResult && uploadResult.id) {
                            const panelImage = {
                                id: uploadResult.id,
                                name: file.name,
                                src: uploadResult.httpUrl,
                                ftpUrl: uploadResult.url,
                                timestamp: new Date(),
                            };
                            uploadedImages.push(panelImage);
                            addImageToPanel(panelImage);
                        }
                    }
                }
                this.value = '';
            });
        }

        // Hàm load ảnh từ server khi mở form
        async function loadImagesFromServer(idPhieuTTPT) {
            try {
                const response = await fetch(`/thu_thuat_phau_thuat/trinh-tu/get-images/${idPhieuTTPT}`);
                const result = await response.json();

                if (result.success && result.data) {
                    result.data.forEach(image => {
                        const panelImage = {
                            id: image.id,
                            name: image.tenAnh,
                            src: image.httpUrl,
                            ftpUrl: image.url,
                            timestamp: new Date(image.thoiGianTao)
                        };
                        uploadedImages.push(panelImage);
                        addImageToPanel(panelImage);
                    });
                }
            } catch (error) {
                console.error('Error loading images:', error);
            }
        }
        loadImagesFromServer(window.IDPhieuTTPT);
    })();

    (function () {
        // Lắng nghe click ảnh trong panel trái
        document.addEventListener('click', function (e) {
            // Click trên ảnh trong panel trái
            const img = e.target.closest('.image-item-preview');
            if (img) {
                const modalEl = document.getElementById('imagePreviewModal');
                const modalImg = document.getElementById('imagePreviewModalImg');
                if (modalEl && modalImg) {
                    modalImg.src = img.src;
                    // Hiện modal (xử lý cho cả Bootstrap 4/5)
                    if (window.bootstrap && window.bootstrap.Modal) {
                        new window.bootstrap.Modal(modalEl).show();
                    } else if ($(modalEl).modal) {
                        $(modalEl).modal('show');
                    }
                }
            }
        });

        // Ảnh trong content editor nếu có: click cũng preview
        document.getElementById('editorContent').addEventListener('click', function (e) {
            const img = e.target.closest('img');
            if (img) {
                const modalEl = document.getElementById('imagePreviewModal');
                const modalImg = document.getElementById('imagePreviewModalImg');
                if (modalEl && modalImg) {
                    modalImg.src = img.src;
                    if (window.bootstrap && window.bootstrap.Modal) {
                        new window.bootstrap.Modal(modalEl).show();
                    } else if ($(modalEl).modal) {
                        $(modalEl).modal('show');
                    }
                }
            }
        });
    })();

    // --- Toolbar commands ---
    function execCmd(command, value = null) {
        document.execCommand(command, false, value);
        document.getElementById('editorContent').focus();
    }

    // Tooltip
    [...document.querySelectorAll('[data-bs-toggle="tooltip"]')]
        .forEach(el => new bootstrap.Tooltip(el));

    async function loadTrinhTuVaKetLuanWithFocus(idPhieuTTPT) {
        if (!idPhieuTTPT || idPhieuTTPT === 0) return;
        try {
            var response = await fetch(`/thu_thuat_phau_thuat/trinh-tu/list-by-idttpt/${idPhieuTTPT}`);
            if (!response.ok) throw new Error('Network response was not ok');
            var data = await response.json();
            console.log(data)
            const editorDiagram = document.getElementById('editorDiagram');
            const editorContent = document.getElementById('editorContent');
            if (data.data.length === 0) return;
            editorDiagram.innerHTML = data.data[0].thongTinLuocDo || '';
            editorContent.innerHTML = data.data[0].trinhTu || '';
            document.querySelector('.editor-summary').innerText = data.data[0].ketLuan || '';
            setTimeout(() => {
                editorContent.focus();
                const range = document.createRange();
                const selection = window.getSelection();
                if (editorContent.childNodes.length > 0) {
                    range.selectNodeContents(editorContent);
                    range.collapse(false);
                } else {
                    const p = document.createElement('p');
                    p.innerHTML = '&nbsp;';
                    editorContent.appendChild(p);
                    range.setStart(p, 0);
                    range.collapse(true);
                }
                selection.removeAllRanges();
                selection.addRange(range);
            }, 100);
        }
        catch (error) {
            console.error('Error fetching data:', error);
        }
    }
    loadTrinhTuVaKetLuanWithFocus(window.IDPhieuTTPT);
    window.loadTrinhTuVaKetLuanWithFocus = loadTrinhTuVaKetLuanWithFocus;
</script>
<script>
    window.currentPdfContent = window.currentPdfContent || '';

    // Xử lý upload PDF
    document.getElementById('pdfUpload').addEventListener('change', async function(e) {
        const file = e.target.files[0];
        if (!file) return;

        if (file.type !== 'application/pdf') {
            alert('Vui lòng chọn file PDF');
            return;
        }

        if (file.size > 10 * 1024 * 1024) { // 10MB limit
            alert('File PDF không được vượt quá 10MB');
            return;
        }

        await processPdfFile(file);
    });

    async function processPdfFile(file) {
        try {
            const formData = new FormData();
            formData.append('pdfFile', file);
            formData.append('idPhieuTTPT', window.IDPhieuTTPT);

            const response = await fetch('/api/pdf/extract-formatted', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                showPdfPreviewWithFormat(result.data);
            } else {
                alert('Lỗi trích xuất PDF: ' + result.message);
            }
        } catch (error) {
            console.error('Error processing PDF:', error);
            alert('Lỗi xử lý PDF: ' + error.message);
        }
    }

    function showPdfPreviewWithFormat(data) {
        const previewContent = document.getElementById('pdfExtractedContent');
        previewContent.innerHTML = data.htmlContent;

        // Gán trực tiếp vào editor luôn
        const editorContent = document.getElementById('editorContent');
        editorContent.innerHTML = `
            <div class="pdf-import-section">
                <h6>📋 NỘI DUNG IMPORT TỪ PDF:</h6>
                ${data.htmlContent}
            </div>
            <hr>
        `;

        // Nếu bạn vẫn muốn hiển thị modal xem trước thì giữ lại:
        const modal = new bootstrap.Modal(document.getElementById('pdfPreviewModal'));
        modal.show();
    }

    function applyPdfContent() {
        if (!window.currentPdfData) return;

        const editorContent = document.getElementById('editorContent');
        const applyToTuongTrinh = document.getElementById('applyToTuongTrinh').checked;

        if (applyToTuongTrinh) {
            // Insert HTML content trực tiếp, giữ nguyên format
            const importSection = `
                <div class="pdf-import-section">
                    <h6>📋 NỘI DUNG IMPORT TỪ PDF:</h6>
                    ${window.currentPdfData.htmlContent}
                </div>
                <hr>
            `;

            editorContent.innerHTML = importSection + editorContent.innerHTML;
        }

        // Đóng modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('pdfPreviewModal'));
        modal.hide();

        toastr.success('Đã import nội dung PDF với định dạng');
    }

    function formatPdfContentForEditor(content) {
        // Format nội dung PDF cho phù hợp với editor
        return content
            .split('\n')
            .filter(line => line.trim().length > 0)
            .map(line => {
                if (line.includes('LƯỢC ĐỒ') || line.includes('TƯỜNG TRÌNH')) {
                    return `<p><strong>${line.trim()}</strong></p>`;
                }
                return `<p>${line.trim()}</p>`;
            })
            .join('');
    }
</script>

