<link href="~/dist/css/CSS0305/CSS0305TTPT/CSS0305TrinhTuVaKetLuan.css" rel="stylesheet" />
<script src="~/dist/js/J0302/J0302TTPT/J0303TemplateTuongTrinh.js" asp-append-version="true" defer></script>

<script>
    var DEFAULT_KHOA_ID = parseInt(window.MaKhoa || 0);
    window.templateTomSelectInstance = window.templateTomSelectInstance || null;
    window.allTemplatesData = window.allTemplatesData || [];

    function normalizeData(data, tenField = 'Ten', viettatField = 'alias') {
        if (!Array.isArray(data)) return [];
        return data.map(n => {
            const ten = n[tenField]?.trim() || "";
            const viettat = n[viettatField]?.trim() || "";
            let generatedAlias = viettat
                ? viettat.toUpperCase()
                : (ten.split(/\s+|-|\/|\(|\)|[^\w\s]/g).filter(w => w.length > 0)
                    .map(w => w.charAt(0)?.toUpperCase())
                    .join("").replace(/[^A-Z0-9]/g, ''));
            return { ...n, alias: generatedAlias };
        });
    }

    function fetchDataAndNormalize(url, tenField = 'ten', viettatField = 'alias') {
        return new Promise((resolve) => {
            $.ajax({
                url: url,
                method: 'GET',
                dataType: 'json',
                success: templates => resolve(normalizeData(templates, tenField, viettatField)),
                error: () => resolve([])
            });
        });
    }

    async function initTemplateTomSelect(url) {
        allTemplatesData = await fetchDataAndNormalize(url, 'ten', 'ten');
        const templateSelectEl = document.querySelector('.cbTemplateTTPT');
        if (!templateSelectEl && !templateSelectEl.tomselect) return;
        templateTomSelectInstance = new window.TomSelect('.cbTemplateTTPT', {
            options: allTemplatesData,
            valueField: "id",
            labelField: "ten",
            searchField: ["ten", "alias"],
            placeholder: "-- Chọn mẫu --",
            maxItems: 1,
            preload: true,
            render: {
                option: (data, escape) => `
                    <div style="display:flex; justify-content:space-between; width:100%;">
                        <span>${escape(data.ten)}</span>
                        <span style="color:gray; font-size:12px; margin-left:10px;">${escape(data.alias || "")}</span>
                    </div>`,
                item: (data, escape) => `
                    <div style="display:flex; justify-content:space-between; width:100%;">
                        <span>${escape(data.ten)}</span>
                        <span style="color:gray; font-size:12px; margin-left:10px;">${escape(data.alias || "")}</span>
                    </div>`,
                no_results: (data, escape) =>
                    `<div class="no-results" style="padding:6px 10px;color:#999;">Không tìm thấy "${escape(data.input)}"</div>`
            }
        });
    }
    initTemplateTomSelect(`/template_tuong_trinh/LayDanhSachTheoIDKhoa/${DEFAULT_KHOA_ID}`);

    function applyTemplate() {
        if (!templateTomSelectInstance) return;
        const selectedTemplateId = templateTomSelectInstance.getValue();
        const editorContent = document.getElementById('editorContent');
        const diagramContent = document.getElementById('editorDiagram');
        if (!selectedTemplateId) {
            editorContent.innerHTML = '';
            alert("Vui lòng chọn một mẫu tường trình trước khi áp dụng.");
            return;
        }
        const selectedTemplate = allTemplatesData.find(t => t.id.toString() === selectedTemplateId.toString());
        if (selectedTemplate && selectedTemplate.noiDung) {
            editorContent.innerHTML = selectedTemplate.noiDung;
        } else {
            alert("Lỗi: Không tìm thấy nội dung mẫu tường trình.");
        }
        diagramContent.innerHTML = selectedTemplate?.thongTinLuocDo || '';

    }

    function setupEditorFocus() {
        const editors = [
            { element: document.getElementById('editorDiagram'), panel: 'diagram' },
            { element: document.getElementById('editorContent'), panel: 'content' }
        ];

        editors.forEach(({ element, panel }) => {
            element.addEventListener('focus', function() {
                // Remove active class từ tất cả
                document.querySelectorAll('.sequence-infor-panel, .sequence-editor-panel')
                    .forEach(panel => panel.classList.remove('active-panel'));

                // Add active class cho panel hiện tại
                const parentPanel = this.closest('.sequence-infor-panel, .sequence-editor-panel');
                if (parentPanel) {
                    parentPanel.classList.add('active-panel');
                }
            });

            element.addEventListener('blur', function() {
                // Giữ lại border nhưng bỏ highlight mạnh
                const parentPanel = this.closest('.sequence-infor-panel, .sequence-editor-panel');
                if (parentPanel) {
                    parentPanel.classList.remove('active-panel');
                }
            });
        });
    }

    window.activePanelCSS = `
        .sequence-infor-panel.active-panel {
            box-shadow: 0 0 0 2px #1976d2, inset 0 0 8px rgba(25, 118, 210, 0.1);
        }

        .sequence-editor-panel.active-panel {
            box-shadow: 0 0 0 2px #388e3c, inset 0 0 8px rgba(56, 142, 60, 0.1);
        }

        .sequence-container .section-header {
            transition: all 0.3s ease;
        }`;
    window.style = document.createElement('style');
    style.textContent = activePanelCSS;
    document.head.appendChild(style);

    setupEditorFocus();


    // ==== IMAGE PANEL LOGIC: Quản lý ảnh ở panel trái ====
    (function () {
        const btnAddImagePanel = document.getElementById('btnAddImagePanel');
        const fileInput = document.getElementById('fileInput');
        const imagePanel = document.querySelector('.image-panel-body');
        let uploadedImages = [];
        let selectedImages = new Set();
        let totalSelectedCount = 0;

        let imagesFromKhoa = [];
        let imagesFromPhieu = [];
        let hasLoadedKhoa = false;
        let hasLoadedPhieu = false;

        btnAddImagePanel.addEventListener('click', function() {
            fileInput.click();
        });

        // Sự kiện khi chọn file
        fileInput.addEventListener('change', function(e) {
            const files = e.target.files;
            if (files.length > 0) {
                handleImageUpload(files);
            }
            fileInput.value = '';
        });

        // Xử lý upload ảnh
        async function handleImageUpload(files) {
            for (let i = 0; i < files.length; i++) {
                const file = files[i];

                if (!file.type.startsWith('image/')) {
                    alert('Chỉ chấp nhận file ảnh!');
                    continue;
                }

                if (file.size > 10 * 1024 * 1024) {
                    alert(`File ${file.name} vượt quá kích thước cho phép (10MB)`);
                    continue;
                }

                // Tạo loading item
                const loadingItem = document.createElement('div');
                loadingItem.className = 'image-item upload-loading';
                loadingItem.innerHTML = `
                    <div class="image-item-header">
                        <div class="image-item-title">${file.name}</div>
                    </div>
                    <small class="image-item-time">Đang upload...</small>
                    <div class="upload-progress">
                        <div class="progress-bar"></div>
                    </div>
                `;
                imagePanel.appendChild(loadingItem);

                try {
                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('idPhieuTTPT', window.IDPhieuTTPT || 0);

                    const response = await fetch('/thu_thuat_phau_thuat/trinh-tu/upload-image', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        loadingItem.remove();
                        addUploadedImageToPanel(result.data);
                        // console.log(`Upload thành công: ${file.name}`);

                        // Thêm ảnh mới upload vào danh sách imagesFromPhieu
                        const newImage = {
                            id: `phieu_${result.data.id}`,
                            name: result.data.fileName,
                            src: result.data.httpUrl,
                            ftpUrl: result.data.url,
                            timestamp: new Date(),
                            source: 'phieu'
                        };
                        imagesFromPhieu.push(newImage);

                    } else {
                        throw new Error(result.message || 'Upload thất bại');
                    }

                } catch (error) {
                    console.error(`Lỗi upload ảnh ${file.name}:`, error);
                    loadingItem.remove();
                    alert(`Lỗi upload ảnh ${file.name}: ${error.message}`);
                }
            }
        }

        // Thêm ảnh đã upload vào panel
        function addUploadedImageToPanel(imageData) {
            const imageItem = document.createElement('div');
            imageItem.className = 'image-item';
            imageItem.dataset.imageId = `phieu_${imageData.id}`;

            const time = new Date().toLocaleString('vi-VN', {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit'
            });

            imageItem.innerHTML = `
                <input type="checkbox" class="image-item-checkbox mt-1"
                       onchange="toggleImageSelection('phieu_${imageData.id}', this.checked)"
                       style="cursor: pointer;">
                <div class="image-item-header">
                    <div class="image-item-title">${imageData.fileName}</div>
                </div>
                <small class="image-item-time">${time}</small>
                <div style="position: relative;">
                    <img src="${imageData.httpUrl}" class="image-item-preview" alt="${imageData.fileName}">
                </div>
                <button class="preview-btn" data-bs-toggle="tooltip"
                        onclick="previewImage('${imageData.httpUrl}')" title="Xem ảnh"
                        style="position: absolute; top: 10px; right: 10px;">
                    <i class="ti ti-eye"></i>
                </button>
            `;

            imagePanel.insertBefore(imageItem, imagePanel.firstChild);

            const newPreviewBtn = imageItem.querySelector('.preview-btn');
            if (newPreviewBtn && window.bootstrap) {
                new bootstrap.Tooltip(newPreviewBtn, {
                    title: "Xem ảnh",
                    trigger: 'hover focus'
                });
            }
        }

        // Kéo thả ảnh vào panel
        imagePanel.addEventListener('dragover', function(e) {
            e.preventDefault();
            imagePanel.classList.add('drag-over');
        });

        imagePanel.addEventListener('dragleave', function() {
            imagePanel.classList.remove('drag-over');
        });

        imagePanel.addEventListener('drop', function(e) {
            e.preventDefault();
            imagePanel.classList.remove('drag-over');

            const files = e.dataTransfer.files;
            if (files.length > 0) {
                handleImageUpload(files);
            }
        });

        function addImageToPanel(imageData, isChecked = false) {
            const existingImage = imagePanel.querySelector(`[data-image-id="${imageData.id}"]`);
            if (existingImage) {
                if (isChecked) {
                    const checkbox = existingImage.querySelector('.image-item-checkbox');
                    if (checkbox && !checkbox.checked) {
                        checkbox.checked = true;
                        toggleImageSelection(imageData.id, true);
                    }
                }
                return;
            }

            const imageItem = document.createElement('div');
            imageItem.className = 'image-item';
            imageItem.dataset.imageId = imageData.id;

            const time = imageData.timestamp.toLocaleString('vi-VN', {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit'
            });

            imageItem.innerHTML = `
                <input type="checkbox" class="image-item-checkbox mt-1"
                       onchange="toggleImageSelection('${imageData.id}', this.checked)"
                       style="cursor: pointer;" ${isChecked ? 'checked' : ''}>
                <div class="image-item-header">
                    <div class="image-item-title">${imageData.name}</div>
                </div>
                <small class="image-item-time">${time}</small>
                <div style="position: relative;">
                    <img src="${imageData.src}" class="image-item-preview" alt="${imageData.name}">
                </div>
                <button class="preview-btn" data-bs-toggle="tooltip"
                        onclick="previewImage('${imageData.src}')" title="Xem ảnh"
                        style="position: absolute; top: 10px; right: 10px;">
                    <i class="ti ti-eye"></i>
                </button>
            `;
            imagePanel.appendChild(imageItem);

            const newPreviewBtn = imageItem.querySelector('.preview-btn');
            if (newPreviewBtn) {
                new bootstrap.Tooltip(newPreviewBtn, {
                    title: "Xem ảnh",
                    trigger: 'hover focus'
                });
            }

            if (isChecked) {
                selectedImages.add(imageData.id);
                totalSelectedCount++;
                imageItem.classList.add('selected');
                document.querySelector('.count-diagram').textContent = totalSelectedCount;
            }
        }

        function compareAndMarkImages() {
            // console.log('Bắt đầu so sánh ảnh:');
            // console.log('Ảnh từ khoa:', imagesFromKhoa);
            // console.log('Ảnh từ phiếu:', imagesFromPhieu);

            // Xóa tất cả ảnh hiện có trong panel
            const existingImages = imagePanel.querySelectorAll('.image-item');
            existingImages.forEach(img => img.remove());
            selectedImages.clear();
            totalSelectedCount = 0;

            // Tạo map để so sánh nhanh hơn
            const khoaImagesMap = new Map();
            imagesFromKhoa.forEach(img => {
                const key = img.name.toLowerCase().trim();
                khoaImagesMap.set(key, img);
            });

            const phieuImagesMap = new Map();
            imagesFromPhieu.forEach(img => {
                const key = img.name.toLowerCase().trim();
                phieuImagesMap.set(key, img);
            });

            // Xử lý ảnh từ khoa: check nếu có trong phiếu
            imagesFromKhoa.forEach(khoaImage => {
                const khoaImageName = khoaImage.name.toLowerCase().trim();
                const isInPhieu = phieuImagesMap.has(khoaImageName);

                // console.log(`Ảnh khoa "${khoaImage.name}" - Có trong phiếu: ${isInPhieu}`);
                addImageToPanel(khoaImage, isInPhieu);
            });

            // Xử lý ảnh từ phiếu: chỉ thêm những ảnh KHÔNG có trong khoa
            imagesFromPhieu.forEach(phieuImage => {
                const phieuImageName = phieuImage.name.toLowerCase().trim();
                const isInKhoa = khoaImagesMap.has(phieuImageName);

                if (!isInKhoa) {
                    // console.log(`Thêm ảnh từ phiếu (không có trong khoa): ${phieuImage.name}`);
                    addImageToPanel(phieuImage, false);
                } else {
                    // console.log(`Ảnh phiếu "${phieuImage.name}" đã có trong khoa, bỏ qua`);
                }
            });

            document.querySelector('.count-diagram').textContent = totalSelectedCount;
            // console.log('Kết thúc so sánh. Tổng ảnh được chọn:', totalSelectedCount);
        }

        function checkAndCompareImages() {
            if (hasLoadedKhoa && hasLoadedPhieu) {
                // console.log('Cả hai nguồn ảnh đã load xong, bắt đầu so sánh...');
                compareAndMarkImages();
            }
        }

        // Hàm load ảnh từ khoa
        async function loadImagesFromServerByMaKhoa(makhoa) {
            try {
                // console.log('Đang load ảnh từ khoa...');
                const response = await fetch(`/thu_thuat_phau_thuat/trinh-tu/list-anh-truong-trinh-by-makhoa?makhoa=${makhoa}`);
                const result = await response.json();
                // console.log('Kết quả ảnh từ khoa:', result);

                if (result.success && result.images) {
                    imagesFromKhoa = result.images.map((img, index) => ({
                        id: `khoa_${img.id || index + 1}`,
                        name: img.tenAnh,
                        src: img.httpUrl,
                        ftpUrl: img.fullPath,
                        timestamp: new Date(img.modifiedDate || Date.now()),
                        source: 'khoa'
                    }));

                    // console.log('Đã load được', imagesFromKhoa.length, 'ảnh từ khoa');
                    hasLoadedKhoa = true;
                    checkAndCompareImages();
                } else {
                    // console.log('Không có ảnh từ khoa hoặc kết quả không thành công');
                    hasLoadedKhoa = true;
                    checkAndCompareImages();
                }
            } catch (error) {
                console.error('Error loading images from khoa:', error);
                hasLoadedKhoa = true;
                checkAndCompareImages();
            }
        }

        // Hàm load ảnh từ phiếu
        async function loadImagesFromServer(idPhieuTTPT) {
            try {
                // console.log('Đang load ảnh từ phiếu...');
                const response = await fetch(`/thu_thuat_phau_thuat/trinh-tu/get-images/${idPhieuTTPT}`);
                const result = await response.json();
                // console.log("Kết quả ảnh từ phiếu: ", result);

                if (result.success && result.data) {
                    imagesFromPhieu = result.data.map((img, index) => ({
                        id: `phieu_${img.id || index + 1}`,
                        name: img.tenAnh,
                        src: img.httpUrl,
                        ftpUrl: img.url,
                        timestamp: new Date(img.thoiGianTao || Date.now()),
                        source: 'phieu'
                    }));

                    // console.log('Đã load được', imagesFromPhieu.length, 'ảnh từ phiếu');
                    hasLoadedPhieu = true;
                    checkAndCompareImages();
                } else {
                    // console.log('Không có ảnh từ phiếu hoặc kết quả không thành công');
                    hasLoadedPhieu = true;
                    checkAndCompareImages();
                }
            } catch (error) {
                console.error('Error loading images from phieu:', error);
                hasLoadedPhieu = true;
                checkAndCompareImages();
            }
        }

        window.previewImage = function(imageSrc) {
            const modalEl = document.getElementById('imagePreviewModal');
            const modalImg = document.getElementById('imagePreviewModalImg');

            if (modalEl && modalImg) {
                modalImg.src = imageSrc;
                if (window.bootstrap && window.bootstrap.Modal) {
                    new window.bootstrap.Modal(modalEl).show();
                } else if (typeof $ !== 'undefined' && $(modalEl).modal) {
                    $(modalEl).modal('show');
                }
            }
        };

        window.toggleImageSelection = function(imageId, isChecked) {
            const imageItem = document.querySelector(`[data-image-id="${imageId}"]`);

            if (isChecked) {
                selectedImages.add(imageId);
                totalSelectedCount++;
                imageItem.classList.add('selected');
            } else {
                selectedImages.delete(imageId);
                totalSelectedCount--;
                imageItem.classList.remove('selected');
            }

            document.querySelector('.count-diagram').textContent = totalSelectedCount;
        };

        window.getSelectedImages = function() {
            return Array.from(selectedImages).map(id => {
                return [...imagesFromKhoa, ...imagesFromPhieu].find(img => img.id === id);
            }).filter(img => img !== undefined);
        }

        // Gọi hàm load ảnh
        // console.log('Bắt đầu load ảnh...');
        // console.log('MaKhoa:', window.MaKhoa);
        // console.log('IDPhieuTTPT:', window.IDPhieuTTPT);

        loadImagesFromServerByMaKhoa(window.MaKhoa);
        loadImagesFromServer(window.IDPhieuTTPT);
    })();

    (function () {
        
        // Ảnh trong content editor nếu có: click cũng preview
        document.getElementById('editorContent').addEventListener('click', function (e) {
            const img = e.target.closest('img');
            if (img) {
                const modalEl = document.getElementById('imagePreviewModal');
                const modalImg = document.getElementById('imagePreviewModalImg');
                if (modalEl && modalImg) {
                    modalImg.src = img.src;
                    if (window.bootstrap && window.bootstrap.Modal) {
                        new window.bootstrap.Modal(modalEl).show();
                    } else if ($(modalEl).modal) {
                        $(modalEl).modal('show');
                    }
                }
            }
        });
    })();

    // --- Toolbar commands ---
    function execCmd(command, value = null) {
        document.execCommand(command, false, value);
        document.getElementById('editorContent').focus();
    }

    // Tooltip
    [...document.querySelectorAll('[data-bs-toggle="tooltip"]')]
        .forEach(el => new bootstrap.Tooltip(el));

    async function loadTrinhTuVaKetLuanWithFocus(idPhieuTTPT) {
        if (!idPhieuTTPT || idPhieuTTPT === 0) return;
        try {
            var response = await fetch(`/thu_thuat_phau_thuat/trinh-tu/list-by-idttpt/${idPhieuTTPT}`);
            if (!response.ok) throw new Error('Network response was not ok');
            var data = await response.json();
            // console.log(data)
            const editorDiagram = document.getElementById('editorDiagram');
            const editorContent = document.getElementById('editorContent');
            if (data.data.length === 0) return;
            editorDiagram.innerHTML = data.data[0].thongTinLuocDo || '';
            editorContent.innerHTML = data.data[0].trinhTu || '';
            document.querySelector('.editor-summary').innerText = data.data[0].ketLuan || '';
            setTimeout(() => {
                editorContent.focus();
                const range = document.createRange();
                const selection = window.getSelection();
                if (editorContent.childNodes.length > 0) {
                    range.selectNodeContents(editorContent);
                    range.collapse(false);
                } else {
                    const p = document.createElement('p');
                    p.innerHTML = '&nbsp;';
                    editorContent.appendChild(p);
                    range.setStart(p, 0);
                    range.collapse(true);
                }
                selection.removeAllRanges();
                selection.addRange(range);
            }, 100);
        }
        catch (error) {
            console.error('Error fetching data:', error);
        }
    }
    loadTrinhTuVaKetLuanWithFocus(window.IDPhieuTTPT);
    window.loadTrinhTuVaKetLuanWithFocus = loadTrinhTuVaKetLuanWithFocus;
    /* UPDATE MODAL MOI */
    function openModalFnc(){
        var currentIdKhoa = window.IDKhoa;

        openTemplateModal(currentIdKhoa);
        $('#myModal').modal('show');
    }
        function reloadTemplateSelect() {
        const url = `/template_tuong_trinh/LayDanhSachTheoIDKhoa/${DEFAULT_KHOA_ID}`;

        const templateSelectEl = document.querySelector('.cbTemplateTTPT');

        if (templateSelectEl && templateSelectEl.tomselect) {
            templateSelectEl.tomselect.destroy();
            window.templateTomSelectInstance = null; // Reset biến instance
        }

        initTemplateTomSelect(url);

        $('#templateSelect').val('');
    }
        $(document).ready(function() {
        $('#myModal').on('hidden.bs.modal', function (e) {
            console.log("Modal template đã đóng. Đang tải lại danh sách mẫu...");
            reloadTemplateSelect();
        });
    });

</script>

