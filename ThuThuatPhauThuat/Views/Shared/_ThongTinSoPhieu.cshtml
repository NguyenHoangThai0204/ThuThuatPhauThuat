        async function khoiTaoThongTinSoPhieu(tabIndex, isEmpty) {
            // Load dữ liệu nguồn bệnh
            await fetchNguonBenhData();

            // Khởi tạo TomSelect cho nguồn bệnh
            initNguonBenhTomSelect(tabIndex);

            const $batDau = $('.txtDateTimeBatDauThuThuat-' + tabIndex);
            const $ketThuc = $('.txtDateTimeKetThucThuThuat-' + tabIndex);
            const $thoiGianKhoa = $('.txtDateTimeThoiGianKhoa-' + tabIndex);

            function showAlert(message) {
                alert(message); // Có thể thay bằng toastr hoặc modal
            }

            function setupPopupPosition($input, offsetTopExtra = 0) {
                $input.on('dp.show', function () {
                    const $widget = $('.bootstrap-datetimepicker-widget:last');
                    const offset = $input.offset();
                    const inputHeight = $input.outerHeight();
                    const widgetHeight = $widget.outerHeight();
                    const widgetWidth = $widget.outerWidth();
                    const winWidth = $(window).width();
                    const winHeight = $(window).height();
                    const scrollTop = $(window).scrollTop();

                    $widget.css({'transform': 'scale(0.85)','transform-origin': 'top center'});

                    const scaledHeight = widgetHeight * 0.85;
                    const scaledWidth = widgetWidth * 0.85;

                    let left = offset.left + $input.outerWidth() + 10 - 180;
                    let top = offset.top - 20 + offsetTopExtra;

                    if (left + scaledWidth > winWidth - 10) left = offset.left - scaledWidth - 10;
                    if (top < scrollTop + 10) top = offset.top + inputHeight + 10;
                    if (left < 10) left = 10;
                    if (left + scaledWidth > winWidth - 10) left = winWidth - scaledWidth - 10;
                    if (top < scrollTop + 10) top = scrollTop + 10;
                    if (top + scaledHeight > scrollTop + winHeight - 10) top = scrollTop + winHeight - scaledHeight - 10;

                    $widget.appendTo('body').css({position: 'absolute', top: top, left: left, zIndex: 999999}).addClass('active-popup');
                }).on('dp.hide', function () {
                    $('.bootstrap-datetimepicker-widget').removeClass('active-popup').css('transform', '');
                });
            }

            // Khởi tạo datetime picker Bắt đầu
            $batDau.datetimepicker({
                format: 'DD-MM-YYYY HH:mm:ss',
                locale: 'vi',
                useCurrent: false,
                showTodayButton: true,
                showClear: true,
                showClose: true,
                calendarWeeks: false,
                icons: {time:'ti ti-clock',date:'ti ti-calendar-event',up:'ti ti-chevron-up',down:'ti ti-chevron-down',previous:'ti ti-chevron-left',next:'ti ti-chevron-right',clear:'ti ti-trash',close:'ti ti-x'}
            });
            setupPopupPosition($batDau);

            // Khởi tạo datetime picker Kết thúc với ràng buộc ≥ Bắt đầu
            $ketThuc.datetimepicker({
    format: 'DD-MM-YYYY HH:mm:ss',
                locale: 'vi',
                useCurrent: false,
                showTodayButton: true,
                showClear: true,
                showClose: true,
                calendarWeeks: false,
                icons: {time:'ti ti-clock',date:'ti ti-calendar-event',up:'ti ti-chevron-up',down:'ti ti-chevron-down',previous:'ti ti-chevron-left',next:'ti ti-chevron-right',clear:'ti ti-trash',close:'ti ti-x'}
            }).on('dp.change', function(e){
                const ketThucDate = e.date;
                const batDauDate = $batDau.data("DateTimePicker").date();
                const now = moment();
                if(!ketThucDate || ketThucDate.isBefore(batDauDate || now)){
                    toastr.warning('Thời gian kết thúc phải sau thời gian bắt đầu!');
                    $(this).data("DateTimePicker").date(now);
                }
            });
            setupPopupPosition($ketThuc);

            // Khởi tạo datetime picker Thời gian khóa
            $thoiGianKhoa.datetimepicker({
                format: 'DD-MM-YYYY HH:mm:ss',
                locale: 'vi',
                useCurrent: false,
                showTodayButton: true,
                showClear: true,
                showClose: true,
                calendarWeeks: false,
                icons: {time:'ti ti-clock',date:'ti ti-calendar-event',up:'ti ti-chevron-up',down:'ti ti-chevron-down',previous:'ti ti-chevron-left',next:'ti ti-chevron-right',clear:'ti ti-trash',close:'ti ti-x'}
            });
            setupPopupPosition($thoiGianKhoa, 100);

            // Inputmask
            Inputmask({alias:"datetime",inputFormat:"dd-mm-yyyy HH:MM:ss",placeholder:"dd-mm-yyyy hh:mm:ss",clearIncomplete:true}).mask($batDau.add($ketThuc));
            Inputmask({alias:"datetime",inputFormat:"dd-mm-yyyy HH:MM:ss",placeholder:"dd-mm-yyyy hh:mm:ss",clearIncomplete:true}).mask($thoiGianKhoa);

            // Nếu phiếu rỗng → set mặc định là thời gian hiện tại
            if(isEmpty){
                const now = moment().format("DD-MM-YYYY HH:mm:ss");
                $batDau.val(now);
                $ketThuc.val(now);
                $thoiGianKhoa.val(now);
            }
        }
    khoiTaoThongTinSoPhieu(@tabIndex, @(isEmptyModel.ToString().ToLower()));

    // Hàm để lấy giá trị nguồn bệnh đã chọn (có thể sử dụng khi save form)
    function getSelectedNguonBenh() {
        const selector = `#cbNguonBenh_${@tabIndex}`;
        const tomSelectInstance = document.querySelector(selector)?.tomselect;
        return tomSelectInstance ? tomSelectInstance.getValue() : '';
    }

    // Hàm để set giá trị nguồn bệnh (có thể sử dụng khi edit)
    function setNguonBenhValue(value) {
        const selector = `#cbNguonBenh_${@tabIndex}`;
        const tomSelectInstance = document.querySelector(selector)?.tomselect;
        if (tomSelectInstance) {
            tomSelectInstance.setValue(value);
        }
    }
