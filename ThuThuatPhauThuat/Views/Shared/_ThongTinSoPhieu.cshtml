                <select type="text" class="form-select form-select-md tomselected thuThuat__nguonBenh-tom-select-@tabIndex text-dark" name="nguonBenh" value="Trong Bệnh viện"></select>
            </div>
        </div>

        <div class="col-4 col-md-1">
