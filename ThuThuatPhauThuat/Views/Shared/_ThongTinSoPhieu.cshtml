    // Biến toàn cục để lưu dữ liệu nguồn bệnh
    var nguonBenhData = [];

    // Hàm chuẩn hóa dữ liệu cho nguồn bệnh
    function normalizeNguonBenhData(data, tenField = 'ten', viettatField = 'viettat') {
        if (!Array.isArray(data)) {
            console.warn("normalizeNguonBenhData nhận dữ liệu không phải mảng:", data);
            return [];
        }

        return data
            .filter(n => n.active === true || n.active === 1)
            .map(n => {
                // const ten = n[tenField]?.trim() || "";
                // const viettat = n[viettatField]?.trim() || "";
                    const ten = (typeof n[tenField] === 'string' ? n[tenField].trim() : "");
    const viettat = (typeof n[viettatField] === 'string' ? n[viettatField].trim() : "");
                let generatedAlias = "";

                if (viettat !== "") {
                    generatedAlias = viettat.toUpperCase();
                } else {
                    const words = ten.split(/\s+|-|\/|\(|\)|[^\w\s]/g).filter(w => w.length > 0);
                    generatedAlias = words
                        .map(w => w.charAt(0)?.toUpperCase())
                        .join("");
                    generatedAlias = generatedAlias.replace(/[^A-Z0-9]/g, '');
                }

                return {
                    ...n,
                    alias: generatedAlias
                };
            });
    }

    // Hàm fetch dữ liệu nguồn bệnh
    async function fetchNguonBenhData() {
        try {
            console.log("Tới lúc truyền nè ");
            const url = "/NguonBenhTTPT/List"; // hoặc "dist/data/json/DM_NguonBenh.json"

            if (url.endsWith('.json')) {
                const response = await $.getJSON(url);
                nguonBenhData = normalizeNguonBenhData(response);
            } else {
                const response = await $.ajax({
                    url: url,
                    method: 'GET',
                    dataType: 'json'
                });
                nguonBenhData = normalizeNguonBenhData(response);
            }
        } catch (error) {
            console.error("Lỗi khi tải dữ liệu nguồn bệnh:", error);
            // Dữ liệu mẫu fallback
            nguonBenhData = [
                { id: "1", ma: "NB01", ten: "Nguồn bệnh nội trú", alias: "NBNT" },
                { id: "2", ma: "NB02", ten: "Nguồn bệnh ngoại trú", alias: "NBNGT" },
                { id: "3", ma: "NB03", ten: "Cấp cứu", alias: "CC" },
                { id: "4", ma: "NB04", ten: "Chuyển viện", alias: "CV" }
            ];
        }
    }

    // Hàm khởi tạo TomSelect cho nguồn bệnh
    function initNguonBenhTomSelect(tabIndex) {
        const selector = `.thuThuat__nguonBenh-tom-select-${tabIndex}`;

        // Đợi DOM sẵn sàng 1 chút (phòng trường hợp element chưa render kịp)
        setTimeout(() => {
            const elements = document.querySelectorAll(selector);

            elements.forEach(el => {
                // Chỉ khởi tạo nếu đúng là <select> và chưa có TomSelect
                if (el && el.tagName === "SELECT" && !el.tomselect) {
                    const tomSelectInstance = new TomSelect(el, {
                        options: Array.isArray(nguonBenhData) ? nguonBenhData : [],
                        valueField: "id",
                        labelField: "ten",
                        searchField: ["ten", "ma", "alias"],
                        placeholder: "-- Chọn nguồn bệnh --",
                        maxItems: 1,
                        render: {
                            option: (data, escape) => `
                                <div style="display:flex; justify-content:space-between; width:100%;">
                                    <span>${escape(data.ten || "")}</span>
                                    <span style="color:gray; font-size:12px; margin-left:10px;">${escape(data.ma || "")}</span>
                                </div>`,
                            item: (data, escape) => `
                                <div style="display:flex; justify-content:space-between; width:100%;">
                                    <span>${escape(data.ten || "")}</span>
                                    <span style="color:gray; font-size:12px; margin-left:10px;">${escape(data.ma || "")}</span>
                                </div>`
                        },
                        no_results: function (data, escape) {
                            return `<div class="no-results" style="padding:6px 10px;color:#999;">
                                        Không tìm thấy "${escape(data.input)}"
                                    </div>`;
                        }
                    });

                    // Nếu tab có Model sẵn thì set value
                    @if (!isEmptyModel && Model?.IDNguonBenh != null)
                    {
                                <text>
                                    tomSelectInstance.setValue('@Model.IDNguonBenh');
                                </text>
                    }
                }
            });
        }, 50); // delay nhẹ 50ms để DOM chắc chắn có <select>
    }

