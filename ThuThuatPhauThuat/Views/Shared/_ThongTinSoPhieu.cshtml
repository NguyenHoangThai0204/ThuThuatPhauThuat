@{
    var tabIndex = ViewBag.TabIndex ?? 0;
    bool isEmptyModel = Model == null || string.IsNullOrEmpty(Model.SoPhieu);
}

<div class="p-2 bg-azure-lt rounded-2">
    <div class="row mt-1">

        <!-- Số phiếu -->
        <div class="col-12 col-md-3">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <label class="form-label fw-bold me-2" style="min-width: 100px;">Số phiếu:</label>
                @if (isEmptyModel)
                {
                    <input class="form-select form-select-md" id="soPhieu" />
                }
                else
                {
                    <input type="text" class="form-control form-control-md" value="@Model.SoPhieu" readonly />
                }
            </div>
        </div>

        <!-- Nhóm máu -->
        <div class="col-4 col-md-1">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <label class="form-label fw-bold me-2" style="min-width: 60px;">Nhóm máu:</label>
                <span class="form-label text-dark">@Model?.NhomMau</span>
            </div>
        </div>

        <!-- Bắt đầu thủ thuật -->
        <div class="col-12 col-md-4">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <label class="form-label fw-bold me-2" style="min-width: 140px;">Bắt đầu thủ thuật:</label>
                <div class="input-icon w-100">
                    <input type="text"
                           class="form-control form-control-md txtDateTimeBatDauThuThuat-@tabIndex text-dark"
                           value="@(isEmptyModel
                                                                                          ? DateTime.Now.ToString("dd-MM-yyyy HH:mm")
                                                                                          : Model?.BatDauThuThuat?.ToString("dd-MM-yyyy HH:mm") ?? "")"
                           autocomplete="off"
                           @(isEmptyModel ? "" : "")>
                    <span class="input-icon-addon">
                        <i class="ti ti-calendar-event"></i>
                    </span>
                </div>
            </div>
        </div>

        <!-- Thời gian khóa -->
        <div class="col-12 col-md-4">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <label class="form-label fw-bold me-2" style="min-width: 140px;">Thời gian khoá</label>
                <div class="input-icon w-100">
                    <input type="text"
                           class="form-control form-control-md txtDateTimeThoiGianKhoa-@tabIndex text-dark"
                           value="@(isEmptyModel
                                                                                                                     ? DateTime.Now.ToString("dd-MM-yyyy HH:mm")
                                                                                                                     : Model?.ThoiGianKhoa?.ToString("dd-MM-yyyy HH:mm") ?? "")"
                           autocomplete="off"
                           @(isEmptyModel ? "" : "")>
                    <span class="input-icon-addon">
                        <i class="ti ti-calendar-event"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-1">
        <!-- Nguồn bệnh -->
        <div class="col-12 col-md-3">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <label class="form-label fw-bold me-2" style="min-width: 100px;">Nguồn bệnh:</label>
                <select autocomplete="off"
                        class="tom-select thuThuat__nguonBenh-tom-select thuThuat__nguonBenh-tom-select-@tabIndex form-select"
                        id="cbNguonBenh_@tabIndex"></select>
            </div>
        </div>
      

        <!-- Yếu tố Rh -->
        <div class="col-4 col-md-1">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <label class="form-label fw-bold me-2" style="min-width: 72px;">Yếu tố Rh:</label>
                <span class="form-label text-dark">@Model?.YeuToRh</span>
            </div>
        </div>

        <!-- Kết thúc thủ thuật -->
        <div class="col-12 col-md-4">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <label class="form-label fw-bold me-2" style="min-width: 140px;">Kết thúc thủ thuật:</label>
                <div class="input-icon w-100">
                    <input type="text"
                           class="form-control form-control-md txtDateTimeKetThucThuThuat-@tabIndex text-dark"
                           value="@(isEmptyModel
                                                                                          ? DateTime.Now.ToString("dd-MM-yyyy HH:mm")
                                                                                          : Model?.KetThucThuThuat?.ToString("dd-MM-yyyy HH:mm") ?? "")"
                           autocomplete="off"
                           @(isEmptyModel ? "" : "")>
                    <span class="input-icon-addon">
                        <i class="ti ti-calendar-event"></i>
                    </span>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <label class="form-label fw-bold me-2" style="min-width: 140px;">Người khóa:</label>
                <input type="text" id="nguoiKhoa" class="form-control form-control-md text-dark" value="@Model?.NguoiKhoa" autocomplete="off" />
            </div>
        </div>
    </div>
</div>

<script>
    // Biến toàn cục để lưu dữ liệu nguồn bệnh
    var nguonBenhData = [];

    // Hàm chuẩn hóa dữ liệu cho nguồn bệnh
    function normalizeNguonBenhData(data, tenField = 'ten', viettatField = 'viettat') {
        if (!Array.isArray(data)) {
            console.warn("normalizeNguonBenhData nhận dữ liệu không phải mảng:", data);
            return [];
        }

        return data
            .filter(n => n.active === true || n.active === 1)
            .map(n => {
                const ten = n[tenField]?.trim() || "";
                const viettat = n[viettatField]?.trim() || "";
                let generatedAlias = "";

                if (viettat !== "") {
                    generatedAlias = viettat.toUpperCase();
                } else {
                    const words = ten.split(/\s+|-|\/|\(|\)|[^\w\s]/g).filter(w => w.length > 0);
                    generatedAlias = words
                        .map(w => w.charAt(0)?.toUpperCase())
                        .join("");
                    generatedAlias = generatedAlias.replace(/[^A-Z0-9]/g, '');
                }

                return {
                    ...n,
                    alias: generatedAlias
                };
            });
    }

    // Hàm fetch dữ liệu nguồn bệnh
    async function fetchNguonBenhData() {
        try {
            console.log("Tới lúc truyền nè ");
            const url = "/NguonBenhTTPT/List"; // hoặc "dist/data/json/DM_NguonBenh.json"
            
            if (url.endsWith('.json')) {
                const response = await $.getJSON(url);
                nguonBenhData = normalizeNguonBenhData(response);
            } else {
                const response = await $.ajax({
                    url: url,
                    method: 'GET',
                    dataType: 'json'
                });
                nguonBenhData = normalizeNguonBenhData(response);
            }
        } catch (error) {
            console.error("Lỗi khi tải dữ liệu nguồn bệnh:", error);
            // Dữ liệu mẫu fallback
            nguonBenhData = [
                { id: "1", ma: "NB01", ten: "Nguồn bệnh nội trú", alias: "NBNT" },
                { id: "2", ma: "NB02", ten: "Nguồn bệnh ngoại trú", alias: "NBNGT" },
                { id: "3", ma: "NB03", ten: "Cấp cứu", alias: "CC" },
                { id: "4", ma: "NB04", ten: "Chuyển viện", alias: "CV" }
            ];
        }
    }

    // Hàm khởi tạo TomSelect cho nguồn bệnh
    function initNguonBenhTomSelect(tabIndex) {
        const selector = `.thuThuat__nguonBenh-tom-select-${tabIndex}`;
        const elements = document.querySelectorAll(selector);

        elements.forEach(el => {
            if (el && !el.tomselect) {
                const tomSelectInstance = new TomSelect(el, {
                    options: nguonBenhData,
                    valueField: "id",
                    labelField: "ten",
                    searchField: ["ten", "ma", "alias"],
                    placeholder: "-- Chọn nguồn bệnh --",
                    maxItems: 1,
                    render: {
                        option: (data, escape) => `
                            <div style="display:flex; justify-content:space-between; width:100%;">
                                <span>${escape(data.ten)}</span>
                                <span style="color:gray; font-size:12px; margin-left:10px;">${escape(data.ma || "")}</span>
                            </div>`,
                        item: (data, escape) => `
                            <div style="display:flex; justify-content:space-between; width:100%;">
                                <span>${escape(data.ten)}</span>
                                <span style="color:gray; font-size:12px; margin-left:10px;">${escape(data.ma || "")}</span>
                            </div>`
                    },
                    no_results: function (data, escape) {
                        return `<div class="no-results" style="padding:6px 10px;color:#999;">
                                    Không tìm thấy "${escape(data.input)}"
                                </div>`;
                    }
                });

                // Nếu tab có Model sẵn thì set value
                @if (!isEmptyModel && Model?.IDNguonBenh != null)
                {
                        <text>
                        tomSelectInstance.setValue('@Model.IDNguonBenh');
                        </text>
                }
            }
        });
    }

    // Hàm chính khởi tạo thông tin số phiếu
    async function khoiTaoThongTinSoPhieu(tabIndex, isEmpty) {
        // Load dữ liệu nguồn bệnh
        await fetchNguonBenhData();

        // Khởi tạo TomSelect cho nguồn bệnh
        initNguonBenhTomSelect(tabIndex);

        // Khởi tạo datetime picker
        $('.txtDateTimeBatDauThuThuat-' + tabIndex + ', .txtDateTimeKetThucThuThuat-' + tabIndex + ',.txtDateTimeThoiGianKhoa-' + tabIndex).attachDateTimeGroups();

        // Nếu phiếu rỗng → set mặc định là thời gian hiện tại
        if (isEmpty) {
            var now = new Date();
            var formatted = ("0" + now.getDate()).slice(-2) + "-" +
                            ("0" + (now.getMonth() + 1)).slice(-2) + "-" +
                            now.getFullYear() + " " +
                            ("0" + now.getHours()).slice(-2) + ":" +
                            ("0" + now.getMinutes()).slice(-2);

            $('.txtDateTimeBatDauThuThuat-' + tabIndex).val(formatted);
            $('.txtDateTimeKetThucThuThuat-' + tabIndex).val(formatted);
            $('.txtDateTimeThoiGianKhoa-' + tabIndex).val(formatted);
        }
    }

    // Gọi hàm khởi tạo
    khoiTaoThongTinSoPhieu(@tabIndex, @(isEmptyModel.ToString().ToLower()));

    // Hàm để lấy giá trị nguồn bệnh đã chọn (có thể sử dụng khi save form)
    function getSelectedNguonBenh() {
        const selector = `#cbNguonBenh_${@tabIndex}`;
        const tomSelectInstance = document.querySelector(selector)?.tomselect;
        return tomSelectInstance ? tomSelectInstance.getValue() : '';
    }

    // Hàm để set giá trị nguồn bệnh (có thể sử dụng khi edit)
    function setNguonBenhValue(value) {
        const selector = `#cbNguonBenh_${@tabIndex}`;
        const tomSelectInstance = document.querySelector(selector)?.tomselect;
        if (tomSelectInstance) {
            tomSelectInstance.setValue(value);
        }
    }
</script>
